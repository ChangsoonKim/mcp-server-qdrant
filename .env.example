# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-secret-reference
COLLECTION_NAME=coding-memory
QDRANT_AUTO_CREATE_COLLECTION=false
QDRANT_SEARCH_LIMIT=10

# New HA collections only; existing collections must be updated in Qdrant.
QDRANT_COLLECTION_SHARDS=1
QDRANT_COLLECTION_REPLICATION_FACTOR=3
QDRANT_COLLECTION_WRITE_CONSISTENCY_FACTOR=2

# Public MCP endpoint
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PATH=/mcp
HTTP_ALLOWED_HOSTS=memory.example.com
HTTP_ALLOWED_ORIGINS=https://memory.example.com

# Google OAuth/OIDC proxy. Configure this exact upstream redirect URI:
# https://memory.example.com/auth/callback
AUTH_MODE=google
AUTH_BASE_URL=https://memory.example.com
AUTH_CLIENT_ID=replace-with-google-oauth-client-id
AUTH_CLIENT_SECRET=replace-with-a-secret-reference
AUTH_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
AUTH_ALLOWED_EMAILS=owner@example.com

# Required by default. This keeps registrations, authorization transactions,
# token mappings, and refresh metadata stable across restarts and replicas.
AUTH_STATE_REDIS_URL=rediss://redis.example.internal:6379/0
AUTH_STORAGE_ENCRYPTION_KEY=replace-with-another-32-character-random-secret
# Single-replica development escape hatch only; keep false in production.
AUTH_ALLOW_LOCAL_STATE=false

# Same authenticated user shares memory across computers. Set shared only when
# every allowlisted user should see the same collection contents.
TENANCY_MODE=user

# Audit JSON is emitted to stderr by default (stdout remains MCP-stdio safe).
AUDIT_LOG_ENABLED=true
INPUT_REJECT_SECRETS=true
